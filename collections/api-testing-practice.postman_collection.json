              "raw": "{{jsonplaceholder}}/posts",
              "host": [
                "{{jsonplaceholder}}"
              ],
              "path": [
                "posts"
              ]
            },
            "description": "Happy path list. Verifies shape and count."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response time < 1500ms\", () => pm.expect(pm.response.responseTime).to.be.below(1500));",
                  "pm.test(\"Content-Type is JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
                  "pm.test(\"Returns 100 posts\", () => pm.expect(pm.response.json()).to.have.lengthOf(100));",
                  "pm.test(\"Each post has id, userId, title, body\", () => { const p = pm.response.json()[0]; pm.expect(p).to.have.all.keys(\"id\",\"userId\",\"title\",\"body\"); });"
                ]
              }
            }
          ],
          "response": []
