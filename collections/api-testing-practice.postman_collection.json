            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Content-Type is JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
                  "const b = pm.response.json();",
                  "pm.test(\"Returns new id\", () => pm.expect(b.id).to.eql(101));",
                  "pm.test(\"Echoes title and body\", () => { pm.expect(b.title).to.eql(\"QA practice post\"); pm.expect(b.body).to.eql(\"Created from Postman\"); });",
                  "pm.collectionVariables.set(\"createdPostId\", b.id);"
